{
  "name": "robinhacks",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev -w @robinhacks/web",
    "dev:firebase": "node scripts/dev-firebase.mjs",
    "emulators": "node scripts/emulator-cli.mjs",
    "seed": "node scripts/seed-emulator.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:domain": "vitest run packages/core",
    "test:emulator": "node scripts/emulator-cli.mjs --test",
    "build:web": "npm run build -w @robinhacks/web",
    "build:functions": "esbuild apps/functions/src/index.ts --bundle --platform=node --target=node22 --format=cjs --outfile=apps/functions/lib/index.cjs --external:firebase-admin --external:firebase-admin/* --external:firebase-functions --external:firebase-functions/*",
    "build": "npm run typecheck && npm run build:web && npm run build:functions",
    "check": "npm run typecheck && npm test && npm run build:web && npm run build:functions",
    "deploy": "npm run build && npx -y firebase-tools@latest deploy --only hosting,firestore,functions",
    "reconcile": "node scripts/reconcile-export.mjs",
    "format": "prettier --write apps packages scripts tests *.json *.ts",
    "format:check": "prettier --check apps packages scripts tests *.json *.ts",
    "test:smoke": "node scripts/smoke-firebase.mjs",
    "bootstrap:firebase": "node --env-file=.env.operations scripts/bootstrap-firebase.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "google-auth-library": "^10.9.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "type": "module",
  "overrides": {
    "uuid": "^11.1.1"
  }
}
