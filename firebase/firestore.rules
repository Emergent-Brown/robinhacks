rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // All mutations and private data use authorized server services. These
    // document reads are narrow listeners for membership and event changes.
    function verifiedGoogle() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function available(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)).data.get('maintenance', false) == false;
    }
    function approved(eventId) {
      return verifiedGoogle() && available(eventId)
        && exists(/databases/$(database)/documents/events/$(eventId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/events/$(eventId)/members/$(request.auth.uid)).data.status == 'approved';
    }
    function membership(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)/members/$(request.auth.uid)).data;
    }
    match /events/{eventId} {
      // Unassigned participants need this listener to see formation open/close.
      allow get: if approved(eventId);
      allow list, create, update, delete: if false;
      match /members/{uid} {
        allow get: if verifiedGoogle() && request.auth.uid == uid;
        allow list, create, update, delete: if false;
      }
      match /views/market {
        allow get: if approved(eventId)
          && (membership(eventId).role == 'organizer'
            || (membership(eventId).teamId != null
              && membership(eventId).role in ['captain', 'trader', 'member']));
        allow list, create, update, delete: if false;
      }
      // Only a channel summary is broadcast. Messages and read cursors use the server API.
      match /messageChannels/general {
        allow get: if approved(eventId);
        allow list, create, update, delete: if false;
      }
      match /teamInboxes/{teamId} {
        allow get: if approved(eventId)
          && membership(eventId).teamId == teamId
          && membership(eventId).role in ['captain', 'trader', 'member'];
        allow list, create, update, delete: if false;
      }
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
